rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /cuttings/{cuttingId}/photos/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vines/{vineId}/photos/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A migrált tőkefotók rekordjai a régi, eseményes útvonalra mutatnak, ezért a
    // szabály megmarad: az objektum olvasható és admin által törölhető. Új
    // feltöltés soha nem ide kerül.
    match /vines/{vineId}/events/{eventId}/photos/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessions/{deviceId}/{sessionId}/events/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
